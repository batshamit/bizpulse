# ============================================================
# BizPulse — environment variables (template)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Runtime ---
BIZPULSE_ENV=dev                       # dev | staging | prod
BIZPULSE_LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432                     # change to 5433 if running our own instance
POSTGRES_DB=bizpulse
POSTGRES_USER=bizpulse
POSTGRES_PASSWORD=change-me-strong

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=                        # leave blank for unauthenticated local

# --- LLM (vLLM, OpenAI-compatible) ---
LLM_BASE_URL=http://127.0.0.1:8800/v1
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_API_KEY=EMPTY                      # vLLM ignores; required by openai client

# --- Embeddings (Text Embeddings Inference) ---
EMBED_BASE_URL=http://127.0.0.1:8081
EMBED_MODEL=BAAI/bge-large-en-v1.5
EMBED_DIM=1024

# --- Reranker (Text Embeddings Inference, second instance) ---
RERANK_BASE_URL=http://127.0.0.1:8082
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Anthropic fallback (optional, for high-stakes synthesis) ---
ANTHROPIC_API_KEY=

# --- External MCP / search tools ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- HuggingFace cache (so model downloads land on /raid, not /home) ---
HF_HOME=/raid/amit/mylearning/bizpulse/.cache/huggingface
HF_HUB_ENABLE_HF_TRANSFER=1

# --- Multi-tenant default ---
BIZPULSE_DEFAULT_TENANT=demo
